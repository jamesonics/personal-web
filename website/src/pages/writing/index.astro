---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Icon from '../../components/Icon.astro';
const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout title="Writing" description="关于 AI Agent、RAG、研究工作流与项目复盘的文章。">
  <section class="page-hero container writing-hero">
    <p class="eyebrow reveal">Writing</p>
    <h1 class="reveal">Notes from research,<br/><em>building and reflection.</em></h1>
    <p class="page-lead reveal">我把博客当作公开的研究日志：记录如何做判断、哪里失败，以及下一次如何做得更好。</p>
    <div class="search-shell reveal"><Icon name="search" /><input type="search" placeholder="Search articles..." aria-label="Search articles" data-article-search /></div>
  </section>
  <section class="section container">
    <div class="article-grid article-index" data-article-list>{posts.map((post) => <ArticleCard post={post} />)}</div>
    <p class="empty-state" data-empty-state hidden>No matching articles yet.</p>
  </section>
</BaseLayout>

<script>
  const searchInput = document.querySelector<HTMLInputElement>('[data-article-search]');
  searchInput?.addEventListener('input', () => {
    const query = searchInput.value.trim().toLowerCase();
    let matches = 0;
    document.querySelectorAll<HTMLElement>('[data-article-list] .article-card').forEach((card) => {
      const visible = !query || (card.textContent ?? '').toLowerCase().includes(query);
      card.hidden = !visible;
      if (visible) matches += 1;
    });
    const empty = document.querySelector<HTMLElement>('[data-empty-state]');
    if (empty) empty.hidden = matches > 0;
  });
</script>

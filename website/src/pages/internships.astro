---
import BaseLayout from '../layouts/BaseLayout.astro';
import InternshipCard from '../components/InternshipCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { experience } from '../data/profile';
import { site } from '../data/site';
---
<BaseLayout
  title="实习"
  description="刘子涵在 Agent 基础设施、评测平台与智慧城市方向的实习经历。"
>
  <div class="main-column page-content-layer internship-overview-page">
    <section class="page-header">
      <h1>实习经历</h1>
      <p>每段经历先呈现角色、方向与核心贡献；点击卡片，可以进一步查看完整的工作内容、产出、价值和阶段性复盘。</p>
    </section>

    <section class="content-section">
      <SectionHeading
        title="经历概览"
        description="从 Agent 研发与评测基础设施，到智慧城市业务研究与方案支持。"
      />
      <div class="internship-list">
        {experience.map((item, index) => (
          <InternshipCard
            company={item.organization}
            role={item.role}
            period={item.period}
            location={item.location}
            accent={item.accent}
            summary={item.summary}
            bullets={item.bullets.slice(0, 2)}
            logoImage={item.logo === 'bytedance' ? `${site.base}/images/logos/bytedance.svg` : `${site.base}/images/logos/gpdi.png`}
            href={`${site.base}/internships/${item.slug}/`}
            logoWide={true}
            draft={item.draft}
            current={index === 0}
          />
        ))}
      </div>
    </section>

    <section class="internship-note">
      <h2>关于公开边界</h2>
      <p>详情页只记录可以公开的工作方向、个人贡献和价值判断，不披露内部数据、系统细节或敏感业务信息。</p>
      <a href={`mailto:${site.email}`}>联系我交流 Agent、评测与工程实践</a>
    </section>
  </div>
</BaseLayout>

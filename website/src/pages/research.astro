---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { education } from '../data/profile';
---
<BaseLayout title="研究" description="刘子涵关于垂类智能体、RAG 评测与人机协作的研究方向。">
  <div class="main-column">
    <section class="page-header"><h1>研究方向</h1><p>探索 AI Agent、知识增强与工程设计的交叉问题，让智能体在专业场景中可靠地理解知识、调用工具并与人协作。</p></section>
    <section class="content-section">
      <SectionHeading title="当前关注的问题" />
      <div class="focus-grid">
        <article class="focus-card reveal"><h3>如何获得可信的领域知识？</h3><p>研究文档切分、检索、重排、引用与评测，让回答可以追溯到原始证据。</p></article>
        <article class="focus-card reveal"><h3>如何接入真实工程工具？</h3><p>通过 MCP 和标准工具接口连接计算、数据处理与设计服务。</p></article>
        <article class="focus-card reveal"><h3>人应该在什么时候介入？</h3><p>在不确定、高成本和不可逆节点引入人工确认，保持系统可控。</p></article>
      </div>
    </section>
    <section class="content-section">
      <SectionHeading title="学习与研究经历" />
      <div class="simple-timeline">
        {education.map((item) => <article class="reveal"><div><h3>{item.school}</h3><p>{item.degree}</p><span>{item.details}</span></div><time>{item.period}</time></article>)}
        <article class="reveal"><div><h3>当前研究</h3><p>叶轮机械智能设计、RAG 评测与科研工作流自动化</p><span>持续构建、评估并记录真实系统。</span></div><time>至今</time></article>
      </div>
    </section>
    <section class="content-section"><SectionHeading title="研究方法" /><div class="method-cards"><span>追溯原始证据</span><span>先构建最小可用闭环</span><span>重点分析失败案例</span><span>保留人工确认节点</span><span>沉淀可复用成果</span></div></section>
  </div>
</BaseLayout>

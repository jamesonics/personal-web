---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { projects } from '../../data/projects';
import { site } from '../../data/site';
export function getStaticPaths() { return projects.map((project) => ({ params: { slug: project.slug }, props: { project } })); }
const { project } = Astro.props;
---
<BaseLayout title={project.title} description={project.summary}>
  <article class="project-detail container" data-pagefind-body>
    <a class="back-link" href={`${site.base}/projects/`}>← Back to Projects</a>
    <header class:list={['project-detail-hero', `accent-${project.accent}`]}>
      <div>
        <p class="eyebrow">{project.category} · {project.year}</p>
        <h1>{project.title}</h1>
        <p class="project-english-title">{project.englishTitle}</p>
        <p class="project-detail-lead">{project.summary}</p>
        <div class="project-tags">{project.tags.map((tag: string) => <span>{tag}</span>)}</div>
      </div>
      <div class="detail-visual" aria-hidden="true"><span></span><span></span><i></i><strong>{project.slug.split('-').map((x: string) => x[0]).join('').toUpperCase()}</strong></div>
    </header>
    <section class="project-overview">
      <div class="project-role"><p class="eyebrow">Role</p><h2>{project.role}</h2><p>{project.description}</p></div>
      <div class="project-metrics">{project.metrics.map((metric: any) => <div><strong>{metric.value}</strong><span>{metric.label}</span></div>)}</div>
    </section>
    <section class="project-process">
      <div><p class="eyebrow">Contribution</p><h2>我在项目中做了什么</h2></div>
      <ol>{project.highlights.map((item: string, index: number) => <li><span>0{index + 1}</span><p>{item}</p></li>)}</ol>
    </section>
    <section class="project-reflection">
      <p class="eyebrow">Reflection</p>
      <blockquote>“真正有价值的项目，不只是完成一个功能，而是让问题、证据、实现与结果形成一条可解释的链路。”</blockquote>
      <a class="button secondary" href={`mailto:${site.email}?subject=${encodeURIComponent(`聊聊项目：${project.title}`)}`}>Discuss this work <Icon name="mail" /></a>
    </section>
  </article>
</BaseLayout>

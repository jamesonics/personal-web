---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectListItem from '../components/ProjectListItem.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Icon from '../components/Icon.astro';
import { featuredProjects } from '../data/projects';
import { site, stats } from '../data/site';
const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
---
<BaseLayout>
  <div class="main-column">
    <section class="hero">
      <div class="hero-copy reveal">
        <h1>你好，我是刘子涵</h1>
        <p class="hero-role">西安交通大学硕士研究生，研究方向为 AI Agent 与 RAG。</p>
        <p class="hero-intro">我关注如何让大模型理解专业知识、调用工程工具，并真正进入科研与工程工作流。</p>
        <div class="hero-actions">
          <a class="button primary" href={`${site.base}/projects/`}>查看我的项目 <Icon name="arrow" /></a>
          <a class="button secondary" href={`${site.base}/docs/CV_Chinese.pdf`} target="_blank">下载简历 <Icon name="download" /></a>
        </div>
      </div>
      <img class="hero-avatar reveal" src={`${site.base}/images/profile.jpg`} alt="刘子涵" width="643" height="900" />
    </section>

    <section class="home-section">
      <SectionHeading title="关于我" />
      <p class="about-summary reveal">目前主要研究垂类智能体、RAG 评测和多智能体协作系统。本科阶段接受机械工程与产品创新训练，之后逐步将计算机视觉、大模型和智能体技术应用到真实工程问题中。</p>
    </section>

    <section class="home-section">
      <SectionHeading title="研究方向" />
      <div class="focus-grid">
        <article class="focus-card reveal"><h3>垂类智能体</h3><p>让 Agent 理解专业知识、工程约束和任务流程。</p></article>
        <article class="focus-card reveal"><h3>RAG 与评测</h3><p>建立可追溯的检索、引用和回归评测链路。</p></article>
        <article class="focus-card reveal"><h3>多智能体协作</h3><p>研究复杂任务中的分工、工具调用与人工确认。</p></article>
      </div>
    </section>

    <section class="home-section">
      <div class="section-row">
        <SectionHeading title="代表项目" description="三个当前最具代表性的项目。" />
        <a class="simple-link" href={`${site.base}/projects/`}>查看全部 {stats[0].value} 个项目 <Icon name="arrow" size={18} /></a>
      </div>
      <div class="project-card-grid">
        {featuredProjects.map((project, index) => <ProjectListItem project={project} number={String(index + 1).padStart(2, '0')} />)}
      </div>
    </section>

    <section class="home-section">
      <div class="section-row">
        <SectionHeading title="最新文章" description="记录研究、开发与项目复盘。" />
        <a class="simple-link" href={`${site.base}/writing/`}>查看全部文章 <Icon name="arrow" size={18} /></a>
      </div>
      <div class="article-grid">{posts.map((post) => <ArticleCard post={post} />)}</div>
    </section>

    <section class="home-section personal-card reveal">
      <img src={`${site.base}/images/optimized/basketball-game.jpg`} alt="篮球比赛剪影" loading="lazy" />
      <div><h2>研究之外</h2><p>我长期参与篮球训练，曾任学院篮球队队长并入选校男篮阳光组。篮球让我更重视长期投入、明确分工和团队协作。</p><a class="simple-link" href={`${site.base}/about/`}>了解更多 <Icon name="arrow" size={18} /></a></div>
    </section>
  </div>
</BaseLayout>

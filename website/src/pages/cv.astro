---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { education, experience, honors, patents, skillGroups } from '../data/profile';
import { projects } from '../data/projects';
import { site } from '../data/site';
---
<BaseLayout title="CV" description="刘子涵的教育、研究、项目、技能、实习、奖项与专利经历。">
  <section class="cv-header container">
    <div><p class="eyebrow">Curriculum Vitae</p><h1>{site.name}<br/><em>{site.englishName}</em></h1><p>{site.title}<br/>{site.affiliation}</p></div>
    <div class="cv-actions"><a class="button primary" href={`${site.base}/docs/CV_Chinese.pdf`} target="_blank">中文简历 <Icon name="download" /></a><a class="button secondary" href={`${site.base}/docs/CV_English.pdf`} target="_blank">English CV <Icon name="download" /></a></div>
  </section>
  <div class="cv-page container" data-pagefind-body>
    <aside class="cv-sidebar">
      <section><h2>Contact</h2><a href={`mailto:${site.email}`}>{site.email}</a><a href={site.github} target="_blank">github.com/topjames666</a></section>
      <section><h2>Research</h2><p>Domain-specific Agents</p><p>RAG & Evaluation</p><p>Multi-Agent Systems</p><p>AI for Engineering</p></section>
      <section><h2>Skills</h2>{skillGroups.map((group) => <div class="cv-skill-group"><h3>{group.title}</h3><p>{group.skills.join(' · ')}</p></div>)}</section>
      <section><h2>Patents</h2>{patents.map((patent) => <p><strong>{patent.title}</strong><br/>{patent.role}<br/><small>{patent.number}</small></p>)}</section>
    </aside>
    <div class="cv-main">
      <section class="cv-block"><h2>Education</h2>{education.map((item) => <article><div><h3>{item.school}</h3><p>{item.degree}</p><small>{item.meta} · {item.details}</small></div><time>{item.period}</time></article>)}</section>
      <section class="cv-block"><h2>Selected Projects</h2>{projects.slice(0, 6).map((project) => <article><div><h3>{project.title}</h3><p>{project.role} · {project.summary}</p><small>{project.tags.join(' · ')}</small></div><time>{project.year}</time></article>)}</section>
      <section class="cv-block" id="experience"><h2>Experience</h2>{experience.map((item) => <article><div><h3>{item.organization}</h3><p>{item.role}</p><ul>{item.bullets.map((bullet) => <li>{bullet}</li>)}</ul></div><time>{item.period}</time></article>)}</section>
      <section class="cv-block" id="honors"><h2>Honors</h2>{honors.map((honor) => <article class="honor-row"><div><h3>{honor.title}</h3><small>{honor.type}</small></div><time>{honor.year}</time></article>)}</section>
    </div>
  </div>
</BaseLayout>

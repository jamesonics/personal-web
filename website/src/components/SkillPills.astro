---
import { siDocker, siGit, siLangchain, siPytorch, siPython, siQdrant, siReact, siTypescript } from 'simple-icons';
const skills = [
  { name: 'Python', icon: siPython, color: '#3776AB' },
  { name: 'LangChain', icon: siLangchain, color: '#1C3C3C' },
  { name: 'PyTorch', icon: siPytorch, color: '#EE4C2C' },
  { name: 'Qdrant', icon: siQdrant, color: '#DC244C' },
  { name: 'React', icon: siReact, color: '#149ECA' },
  { name: 'TypeScript', icon: siTypescript, color: '#3178C6' },
  { name: 'Docker', icon: siDocker, color: '#2496ED' },
  { name: 'Git', icon: siGit, color: '#F05032' },
];
---
<div class="skill-pills">
  {skills.map((skill) => (
    <span class="skill-pill reveal">
      <svg viewBox="0 0 24 24" aria-hidden="true" style={`color:${skill.color}`}><path fill="currentColor" d={skill.icon.path}></path></svg>
      {skill.name}
    </span>
  ))}
</div>

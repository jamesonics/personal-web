---
interface Props { theme?: string; }
const { theme = 'default' } = Astro.props;
---
<div class:list={['page-ambient', `page-ambient-${theme}`]} aria-hidden="true">
  <canvas data-page-ambient></canvas>
  <span class="ambient-blob ambient-blob-one"></span>
  <span class="ambient-blob ambient-blob-two"></span>
</div>
<script>
  const canvas = document.querySelector<HTMLCanvasElement>('[data-page-ambient]');
  if (canvas) {
    const context = canvas.getContext('2d');
    const motionPreference = matchMedia('(prefers-reduced-motion: reduce)');
    let reduced = motionPreference.matches;
    let width = 0;
    let height = 0;
    let frame = 0;
    const resize = () => {
      const ratio = Math.min(devicePixelRatio || 1, 2);
      width = canvas.clientWidth;
      height = canvas.clientHeight;
      canvas.width = width * ratio;
      canvas.height = height * ratio;
      context?.setTransform(ratio, 0, 0, ratio, 0, 0);
    };
    const draw = (time = 0) => {
      if (!context) return;
      context.clearRect(0, 0, width, height);
      const gap = 17;
      for (let y = 8; y < height; y += gap) {
        for (let x = 8; x < width; x += gap) {
          const wave = reduced ? 0 : Math.sin(time * .001 + x * .018 + y * .025);
          const distance = Math.hypot(x - width * .7, y - height * .25);
          const glow = Math.max(0, 1 - distance / Math.max(width, height));
          context.beginPath();
          context.fillStyle = `rgba(23,23,23,${.035 + glow * .055 + Math.max(0, wave) * .035})`;
          context.arc(x, y + wave * 1.5, 1 + glow * .45, 0, Math.PI * 2);
          context.fill();
        }
      }
      frame = !reduced && !document.hidden ? requestAnimationFrame(draw) : 0;
    };
    const stop = () => {
      if (frame) cancelAnimationFrame(frame);
      frame = 0;
    };
    const restart = () => {
      stop();
      draw(performance.now());
    };
    const handleResize = () => {
      resize();
      restart();
    };
    const handleVisibility = () => document.hidden ? stop() : restart();
    const handleMotionPreference = (event: MediaQueryListEvent) => {
      reduced = event.matches;
      restart();
    };
    resize();
    restart();
    addEventListener('resize', handleResize);
    document.addEventListener('visibilitychange', handleVisibility);
    motionPreference.addEventListener('change', handleMotionPreference);
    addEventListener('pagehide', stop);
    addEventListener('pageshow', restart);
  }
</script>

---
import Icon from './Icon.astro';
import { site } from '../data/site';
---
<nav class="floating-dock" aria-label="快捷入口">
  <a href={`${site.base}/`} aria-label="首页"><span class="dock-tooltip">首页</span><Icon name="home" size={27} /></a>
  <a href={`${site.base}/projects/`} aria-label="项目"><span class="dock-tooltip">项目</span><Icon name="folder" size={27} /></a>
  <a href={`${site.base}/blog/`} aria-label="Blog"><span class="dock-tooltip">Blog</span><Icon name="writing" size={27} /></a>
  <a href={`${site.base}/internships/`} aria-label="实习"><span class="dock-tooltip">实习</span><Icon name="briefcase" size={27} /></a>
  <i></i>
  <a href={site.github} target="_blank" rel="noreferrer" aria-label="GitHub"><span class="dock-tooltip">GitHub</span><Icon name="github" size={27} /></a>
  <a href={`mailto:${site.email}`} aria-label="邮箱"><span class="dock-tooltip">邮箱</span><Icon name="mail" size={27} /></a>
</nav>

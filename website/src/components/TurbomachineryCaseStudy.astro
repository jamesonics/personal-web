---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from './Icon.astro';
import { site } from '../data/site';
import type { Project } from '../data/projects';

interface Props { project: Project; }
const { project } = Astro.props;
const base = site.base;
const paperBase = `${base}/images/projects/turbomachinery-agent`;
---
<BaseLayout title={project.title} description={project.summary} image={`${paperBase}/paper-fig01-architecture.png`}>
  <article class="turbo-case" data-pagefind-body>
    <header class="turbo-hero">
      <div class="turbo-hero-grid">
        <div class="turbo-hero-copy">
          <a class="back-link" href={`${base}/projects/`}>← 返回项目列表</a>
          <span class="turbo-kicker">FLAGSHIP RESEARCH PROJECT · 2025—PRESENT</span>
          <h1>叶轮机械<br/><em>智能设计 Agent</em></h1>
          <p class="turbo-lead">以自然语言需求为入口，将专业知识检索、任务规划、工程工具调用与物理验证组织成可追踪的智能设计工作流。</p>
          <div class="turbo-hero-actions">
            <a class="button primary" href="#system-map">查看系统成果图 <Icon name="arrow" /></a>
            <a class="button secondary" href="https://arxiv.org/abs/2604.06747" target="_blank" rel="noreferrer">方法参考论文 <Icon name="external" /></a>
          </div>
        </div>
        <div class="turbo-hero-visual">
          <div class="turbo-radar"><span></span><span></span><span></span><i></i></div>
          <div class="turbo-mini-card turbo-mini-card-one"><b>1401</b><span>页专业文档</span></div>
          <div class="turbo-mini-card turbo-mini-card-two"><b>3</b><span>MCP Servers</span></div>
          <div class="turbo-mini-card turbo-mini-card-three"><b>RAG</b><span>证据增强</span></div>
        </div>
      </div>
      <div class="turbo-status-strip">
        <div><span class="status-dot complete"></span><b>已完成</b><p>专业知识库、RAG、Agent 编排、MCP 工具、流式前端、Docker 部署</p></div>
        <div><span class="status-dot building"></span><b>正在建设</b><p>设计任务模板、评测集、状态追踪、工程工具可靠性</p></div>
        <div><span class="status-dot reference"></span><b>论文目标</b><p>生成设计、性能预测、优化决策、CFD/FEA 闭环验证</p></div>
      </div>
    </header>

    <section class="turbo-section turbo-intro-section">
      <div class="turbo-section-heading"><span>01</span><div><p>PROJECT POSITIONING</p><h2>不是一个“会聊天”的助手，<br/>而是一条可验证的工程设计链路</h2></div></div>
      <div class="turbo-intro-grid">
        <div class="turbo-problem-card">
          <h3>传统流程的断点</h3>
          <ul>
            <li>设计目标、专业知识和仿真工具分散在不同系统中</li>
            <li>高度依赖工程师经验与重复试算，过程难以复用</li>
            <li>脚本只能连接固定步骤，无法根据反馈动态调整</li>
            <li>结果缺少统一证据链，失败原因难以定位</li>
          </ul>
        </div>
        <div class="turbo-goal-card">
          <h3>我的研究目标</h3>
          <p>通过 LangGraph 管理任务状态与条件分支，以 RAG 提供专业知识依据，以 MCP 接入工程工具，并将每次规划、检索、调用和结果保留为可检查记录。</p>
          <blockquote>让“需求理解 → 方案执行 → 结果验证 → 报告沉淀”成为一条可以复现和持续迭代的工作流。</blockquote>
        </div>
      </div>
    </section>

    <section class="turbo-paper-disclosure">
      <div><span>RESEARCH BASIS</span><h2>方法依据与成果边界</h2></div>
      <p>本项目的系统思路与论文 <cite>TurboAgent: An LLM-Driven Autonomous Multi-Agent Framework for Turbomachinery Aerodynamic Design</cite> 高度一致。下方论文图用于解释方法和目标架构；论文中的生成模型、代理模型、优化结果与 CFD/FEA 指标属于论文作者的实验结果，<strong>不作为本项目已经复现的成果</strong>。</p>
    </section>

    <section class="turbo-section" id="system-map">
      <div class="turbo-section-heading"><span>02</span><div><p>SYSTEM OUTCOME MAP</p><h2>从需求到验证的完整成果图</h2></div></div>
      <div class="turbo-system-map">
        <div class="map-stage map-stage-input">
          <span class="map-index">INPUT</span><h3>自然语言设计需求</h3><p>性能目标、约束、工作范围与人工反馈</p>
        </div>
        <span class="map-arrow">→</span>
        <div class="map-stage map-stage-supervisor">
          <span class="map-index">SUPERVISOR</span><h3>任务规划 Agent</h3><p>意图解析、任务拆解、条件分支、状态管理</p><i class="map-status complete">已完成基础</i>
        </div>
        <span class="map-arrow">→</span>
        <div class="map-agent-cluster">
          <div><b>知识 Agent</b><span>RAG · 1401 页文档</span><i class="map-status complete">已完成</i></div>
          <div><b>工程工具 Agent</b><span>3 个 MCP Server</span><i class="map-status complete">已接入</i></div>
          <div><b>生成设计 Agent</b><span>几何参数化 / 生成模型</span><i class="map-status planned">规划中</i></div>
          <div><b>性能预测 Agent</b><span>代理模型快速评估</span><i class="map-status planned">规划中</i></div>
          <div><b>优化 Agent</b><span>多目标搜索与策略更新</span><i class="map-status planned">规划中</i></div>
          <div><b>物理验证 Agent</b><span>CFD / FEA / 后处理</span><i class="map-status planned">规划中</i></div>
        </div>
        <span class="map-arrow">→</span>
        <div class="map-stage map-stage-output">
          <span class="map-index">OUTPUT</span><h3>设计报告与证据链</h3><p>候选方案、性能依据、工具记录、验证结论</p><i class="map-status building">持续完善</i>
        </div>
      </div>
      <div class="turbo-paper-figure turbo-figure-wide">
        <img src={`${paperBase}/paper-fig01-architecture.png`} alt="TurboAgent 论文 Figure 1 多智能体总体架构" loading="lazy" />
        <div><b>论文 Figure 1 · 多智能体总体架构</b><p>LLM 认知中枢、任务规划 Agent、专业功能 Agent、基础模型与工程工具共同组成系统。</p></div>
      </div>
    </section>

    <section class="turbo-section turbo-dark-section">
      <div class="turbo-section-heading light"><span>03</span><div><p>METHOD MAPPING</p><h2>论文中的 Agent，如何映射到我的系统</h2></div></div>
      <div class="turbo-mapping-table">
        <div class="mapping-head"><span>论文模块</span><span>当前实现</span><span>状态</span></div>
        <div><b>Task Planning Agent</b><p>LangGraph 状态图、任务节点、条件路由与执行上下文</p><em class="complete">基础完成</em></div>
        <div><b>Knowledge Synthesis Agent</b><p>专业文档 RAG、Qdrant + Ollama Embedding、来源证据检索</p><em class="complete">已完成</em></div>
        <div><b>Engineering Tools</b><p>通过 langchain-mcp-adapters 接入 3 个 MCP Server</p><em class="complete">已接入</em></div>
        <div><b>Frontend Interface</b><p>Chainlit 流式交互、工具调用展示与模型切换</p><em class="complete">已完成</em></div>
        <div><b>Generation / Prediction</b><p>生成式几何设计与性能代理模型</p><em class="planned">待复现</em></div>
        <div><b>Optimization / Validation</b><p>多目标优化、CFD/FEA 自动执行与结果回传</p><em class="planned">待复现</em></div>
      </div>
      <div class="turbo-paper-figure dark turbo-figure-wide">
        <img src={`${paperBase}/paper-fig02-workflow.png`} alt="TurboAgent 论文 Figure 2 端到端工作流" loading="lazy" />
        <div><b>论文 Figure 2 · 自然语言驱动的闭环工作流</b><p>规划、生成、预测、优化和物理仿真通过知识综合 Agent 连接，并允许专家反馈进入循环。</p></div>
      </div>
    </section>

    <section class="turbo-section">
      <div class="turbo-section-heading"><span>04</span><div><p>CURRENT DELIVERABLES</p><h2>当前已经形成的系统基础</h2></div></div>
      <div class="turbo-deliverables">
        <article><span>01</span><h3>专业知识底座</h3><b>1401 页</b><p>完成叶轮机械专业资料向量化与知识库构建，为设计问答和任务规划提供依据。</p></article>
        <article><span>02</span><h3>Agent 与工具编排</h3><b>LangGraph + MCP</b><p>以状态图组织任务，通过 MCP 将专业工具能力接入 Agent 执行链路。</p></article>
        <article><span>03</span><h3>可交互前端</h3><b>Streaming UI</b><p>支持流式响应、工具调用可视化、模型切换和运行过程反馈。</p></article>
        <article><span>04</span><h3>可部署工程环境</h3><b>Docker</b><p>将知识库、模型与应用服务容器化，降低环境配置和启动成本。</p></article>
      </div>
      <div class="turbo-paper-figure turbo-figure-wide">
        <img src={`${paperBase}/paper-fig04-interface.jpg`} alt="TurboAgent 论文 Figure 4 前端界面" loading="lazy" />
        <div><b>论文 Figure 4 · 前端工作台参考</b><p>自然语言输入、任务进度、结果预览、协作状态与日志在同一界面中展示。</p></div>
      </div>
    </section>

    <section class="turbo-section turbo-workflow-section">
      <div class="turbo-section-heading"><span>05</span><div><p>EXECUTION LOGIC</p><h2>任务规划不是固定脚本，而是条件工作流</h2></div></div>
      <div class="turbo-workflow-cards">
        <article><span>简单任务</span><h3>快速评估</h3><p>直接调用知识检索或性能评估工具，输出可追溯结果。</p><code>需求 → 评估 → 结果</code></article>
        <article><span>组合任务</span><h3>设计与验证</h3><p>生成多个方案，完成快速评估，再进入物理验证。</p><code>设计 → 预测 → CFD/FEA</code></article>
        <article><span>闭环任务</span><h3>不达标则优化</h3><p>根据目标偏差动态触发优化，并返回新的候选方案。</p><code>设计 → 评估 → 优化 ↺</code></article>
      </div>
      <div class="turbo-paper-figure turbo-figure-wide">
        <img src={`${paperBase}/paper-fig05-task-planning.jpg`} alt="TurboAgent 论文 Figure 5 不同任务场景下的规划结果" loading="lazy" />
        <div><b>论文 Figure 5 · 多场景任务规划</b><p>同一自然语言入口可根据任务复杂度生成快速评估、条件验证或优化闭环。</p></div>
      </div>
    </section>

    <section class="turbo-section turbo-benchmark-section">
      <div class="turbo-section-heading"><span>06</span><div><p>PAPER BENCHMARK</p><h2>论文给出的端到端验证基准</h2></div></div>
      <div class="turbo-boundary-warning"><Icon name="external" /><p><strong>以下指标来自 TurboAgent 论文实验，尚不是本项目结果。</strong>它们用于定义后续系统复现和评测的目标基线。</p></div>
      <div class="turbo-benchmark-grid">
        <article><b>10</b><span>候选设计方案</span><p>自然语言目标驱动生成与快速筛选</p></article>
        <article><b>R² &gt; 0.91</b><span>CFD / 目标一致性</span><p>论文报告三项关键性能指标</p></article>
        <article><b>&lt; 8%</b><span>预测 nRMSE</span><p>代理模型与 CFD 结果对比</p></article>
        <article><b>+1.61%</b><span>等熵效率</span><p>论文 LLM 优化相对初始设计</p></article>
        <article><b>+3.02%</b><span>总压比</span><p>论文 LLM 优化相对初始设计</p></article>
        <article><b>≈ 30 min</b><span>并行闭环流程</span><p>论文在 30 CPU 核配置下报告</p></article>
      </div>
      <div class="turbo-results-gallery">
        <figure><img src={`${paperBase}/paper-fig14-end-to-end.png`} alt="TurboAgent 论文 Figure 14 端到端设计流程与结果" loading="lazy" /><figcaption><b>Figure 14</b><span>工作流、方案筛选、性能图和多物理场验证</span></figcaption></figure>
        <figure><img src={`${paperBase}/paper-fig15-human-interaction.jpg`} alt="TurboAgent 论文 Figure 15 人机交互与候选方案评估" loading="lazy" /><figcaption><b>Figure 15</b><span>自然语言任务、方案生成、综合评估和最终推荐</span></figcaption></figure>
      </div>
      <div class="turbo-paper-figure turbo-cost-figure">
        <img src={`${paperBase}/paper-fig16-cost.png`} alt="TurboAgent 论文 Figure 16 成本分析" loading="lazy" />
        <div><b>论文 Figure 16 · 成本分析</b><p>完整闭环约消耗 80k–100k tokens；主要时间开销来自高保真仿真。论文正文报告约 30 分钟量级，Figure 16 图示为 40 min。</p></div>
      </div>
    </section>

    <section class="turbo-section turbo-roadmap-section">
      <div class="turbo-section-heading"><span>07</span><div><p>REPRODUCTION ROADMAP</p><h2>从知识型 Agent 走向完整设计闭环</h2></div></div>
      <div class="turbo-roadmap">
        <article class="done"><span>Phase 1</span><h3>知识与编排基础</h3><p>RAG、LangGraph、MCP、前端与容器化。</p><i>已完成</i></article>
        <article class="active"><span>Phase 2</span><h3>可靠任务执行</h3><p>评测集、失败分类、状态恢复和工具调用验证。</p><i>进行中</i></article>
        <article><span>Phase 3</span><h3>设计与预测 Agent</h3><p>参数化几何生成、代理模型与候选方案筛选。</p><i>下一阶段</i></article>
        <article><span>Phase 4</span><h3>物理验证闭环</h3><p>CFD/FEA 自动运行、后处理、优化和报告生成。</p><i>研究目标</i></article>
      </div>
    </section>

    <section class="turbo-source-section">
      <div><span>REFERENCE & ATTRIBUTION</span><h2>研究来源</h2></div>
      <div>
        <p>Du, J., Wu, Y., Zhao, P., et al. <cite>TurboAgent: An LLM-Driven Autonomous Multi-Agent Framework for Turbomachinery Aerodynamic Design.</cite> arXiv:2604.06747v2, 2026.</p>
        <p>本页使用论文 Figure 1、2、4、5、14、15、16 作为方法与目标基准说明。所有论文图片和论文实验指标均归原作者所有，并已在对应区域标明来源和成果边界。</p>
        <a href="https://arxiv.org/abs/2604.06747" target="_blank" rel="noreferrer">查看论文页面 <Icon name="external" /></a>
      </div>
    </section>
  </article>
</BaseLayout>

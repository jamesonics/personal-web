---
import Icon from './Icon.astro';
import { site } from '../data/site';
interface Props { post: any; }
const { post } = Astro.props;
const date = new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' }).format(post.data.date);
---
<a class="article-card reveal" href={`${site.base}/blog/${post.id}/`}>
  <div class="article-meta"><span>{post.data.category}</span><time>{date}</time></div>
  <h3>{post.data.title}</h3>
  <p>{post.data.description}</p>
  <div class="article-footer"><span>阅读全文</span><Icon name="arrow" size={18} /></div>
</a>

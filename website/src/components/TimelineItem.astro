---
interface Props { logo?: string; image?: string; color: string; title: string; subtitle: string; date: string; logoWide?: boolean; }
const { logo, image, color, title, subtitle, date, logoWide = false } = Astro.props;
---
<article class="timeline-item reveal">
  <span class:list={['timeline-logo', { 'has-image': image, 'is-wide': logoWide }]} style={`--logo-color:${color}`}>
    {image ? <img src={image} alt={`${title}标志`} /> : logo}
  </span>
  <div class="timeline-copy"><h3>{title}</h3><p>{subtitle}</p></div>
  <time>{date}</time>
</article>

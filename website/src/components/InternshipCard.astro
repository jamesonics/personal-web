---
interface Props {
  company: string;
  role: string;
  period: string;
  location: string;
  summary: string;
  bullets: readonly string[];
  accent: string;
  logoText?: string;
  logoPath?: string;
  logoImage?: string;
  draft?: boolean;
}
const { company, role, period, location, summary, bullets, accent, logoText, logoPath, logoImage, draft = false } = Astro.props;
---
<article class="internship-card reveal" style={`--internship-accent:${accent}`}>
  <header class="internship-card-header">
    <span class:list={['internship-logo', { 'has-logo-image': logoImage }]}>
      {logoImage ? <img src={logoImage} alt={`${company}标志`} /> : logoPath ? <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d={logoPath}></path></svg> : <strong>{logoText}</strong>}
    </span>
    <div class="internship-heading"><h2>{company}</h2><p>{role}</p></div>
    <div class="internship-meta"><time>{period}</time><span>{location}</span></div>
  </header>
  <div class="internship-body">
    <p>{summary}</p>
    <ul>{bullets.map((bullet) => <li>{bullet}</li>)}</ul>
    {draft && <span class="draft-badge">内容初稿 · 待后续更新</span>}
  </div>
</article>

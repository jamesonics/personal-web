---
import type { MarkdownHeading } from 'astro';
import ArticleTOC from '../components/ArticleTOC.astro';
import BaseLayout from './BaseLayout.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  date: Date;
  category: string;
  tags?: string[];
  headings?: MarkdownHeading[];
}

const { title, description, date, category, tags = [], headings = [] } = Astro.props;
const hasToc = headings.some((heading) => heading.depth >= 2 && heading.depth <= 4);
const formattedDate = new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' }).format(date);
---
<BaseLayout title={title} description={description}>
  <article class:list={['article-page', hasToc ? 'article-page-with-toc' : 'article-page-no-toc']} data-pagefind-body>
    <div class="article-main-column">
      <a class="back-link" href={`${site.base}/blog/`}>← 返回 Blog</a>
      <header class="article-header">
        <div class="article-kicker"><span>{category}</span><time>{formattedDate}</time></div>
        <h1>{title}</h1>
        <p>{description}</p>
        <div class="article-tags">{tags.map((tag: string) => <span>{tag}</span>)}</div>
      </header>
      <ArticleTOC headings={headings} mode="mobile" />
      <div class="article-prose"><slot /></div>
    </div>
    <ArticleTOC headings={headings} mode="desktop" />
  </article>
</BaseLayout>
